{
  "format_version": 3,
  "id": "encounter_lifecycle",
  "name": "Encounter Lifecycle",
  "spawn": {
    "x": 1.0,
    "z": 8.0
  },
  "rooms": [
    {
      "x": 0.0,
      "z": 0.0,
      "width": 10.0,
      "depth": 10.0,
      "height": 3.0
    }
  ],
  "props": [
    {
      "id": "spooner_man_home",
      "display_name": "Spooner-Man",
      "model": "spooner-man",
      "x": 2.0,
      "y": 0.0,
      "z": 2.0,
      "rotation_degrees": 120.0,
      "size": [
        0.7,
        1.8,
        0.7
      ],
      "components": [
        {
          "component": "interactable",
          "prompt": "Toggle name"
        },
        {
          "component": "animation",
          "clip": "idle",
          "looped": true,
          "playing": false
        },
        {
          "component": "nav_agent",
          "radius": 0.2,
          "height": 0.45,
          "speed_mps": 1.9,
          "step_height": 0.3,
          "max_slope": 2.6667
        },
        {
          "component": "ai",
          "behavior": "predator",
          "role": "predator",
          "reacts_to": [
            "prey_rat"
          ],
          "walk_speed": 0.55,
          "run_speed": 2.2,
          "sight_range": 10.0,
          "sight_fov_degrees": 220.0,
          "hearing_range": 9.0,
          "flee_distance": 5.0,
          "pursue_distance": 20.0,
          "catch_radius": 0.5,
          "catch_height": 0.7,
          "wander_radius": 2.0,
          "idle_seconds": 2.0,
          "can_open_doors": true
        }
      ],
      "bindings": [
        {
          "on": "interact",
          "actions": [
            {
              "action": "toggle_label"
            }
          ]
        },
        {
          "on": "caught",
          "actions": [
            {
              "action": "start_sequence",
              "sequence": "caught_prey"
            }
          ]
        }
      ]
    },
    {
      "id": "rat_release_switch",
      "display_name": "Rat Release Switch",
      "model": "home:wall_switch",
      "x": 2.0,
      "y": 1.2,
      "z": 8.0,
      "rotation_degrees": 180.0,
      "size": [
        0.18,
        0.18,
        0.1
      ],
      "solid": false,
      "components": [
        {
          "component": "interactable",
          "prompt": "Release rat",
          "reach": 1.6
        },
        {
          "component": "animation",
          "clip": "toggle",
          "looped": false,
          "playing": false
        }
      ],
      "bindings": [
        {
          "on": "interact",
          "actions": [
            {
              "action": "toggle_animation",
              "clip": "toggle"
            },
            {
              "action": "spawn_entity",
              "point": "home_rat_spawn_point",
              "group": "home_rat_encounter",
              "name": "encounter_rat"
            }
          ]
        }
      ]
    }
  ],
  "sequences": [
    {
      "id": "caught_prey",
      "steps": [
        {
          "step": "action",
          "action": {
            "action": "play_animation",
            "clip": "pounce",
            "loop": false
          }
        },
        {
          "step": "wait_animation",
          "clip": "pounce",
          "timeout": 2.5
        },
        {
          "step": "action",
          "action": {
            "action": "play_animation",
            "clip": "sit_down",
            "loop": false
          }
        },
        {
          "step": "wait_animation",
          "clip": "sit_down",
          "timeout": 3.0
        },
        {
          "step": "action",
          "action": {
            "action": "play_animation",
            "clip": "sit_idle",
            "loop": true
          }
        },
        {
          "step": "wait",
          "seconds": 2.0
        },
        {
          "step": "action",
          "action": {
            "action": "despawn_entity",
            "target": "home_rat_encounter"
          }
        },
        {
          "step": "action",
          "action": {
            "action": "play_animation",
            "clip": "stand_up",
            "loop": false
          }
        },
        {
          "step": "wait_animation",
          "clip": "stand_up",
          "timeout": 3.0
        },
        {
          "step": "action",
          "action": {
            "action": "play_animation",
            "clip": "idle",
            "loop": true
          }
        },
        {
          "step": "stop"
        }
      ]
    }
  ],
  "spawn_templates": [
    {
      "id": "home_rat",
      "model": "rat",
      "scale": 1.0,
      "components": [
        {
          "component": "nav_agent",
          "radius": 0.1,
          "height": 0.16,
          "speed_mps": 1.35,
          "step_height": 0.2,
          "max_slope": 2.6667
        },
        {
          "component": "ai",
          "behavior": "prey",
          "role": "prey_rat",
          "reacts_to": [
            "predator"
          ],
          "walk_speed": 0.7,
          "run_speed": 1.75,
          "sight_range": 8.0,
          "sight_fov_degrees": 250.0,
          "hearing_range": 9.0,
          "flee_distance": 6.0,
          "pursue_distance": 12.0,
          "catch_radius": 0.4,
          "catch_height": 0.4,
          "wander_radius": 2.0,
          "idle_seconds": 0.8,
          "can_open_doors": false
        }
      ]
    }
  ],
  "spawn_points": [
    {
      "id": "home_rat_spawn_point",
      "x": 8.0,
      "z": 5.0,
      "yaw_degrees": 300.0,
      "template": "home_rat",
      "group": "home_rat_encounter"
    }
  ],
  "spawn_groups": [
    {
      "id": "home_rat_encounter",
      "at_most_one_active": true
    }
  ]
}
