{
  "schema": "places-level",
  "format_version": 1,
  "id": "item_physics_native",
  "name": "Native Item Physics Fixture",
  "author": "Places",
  "comment": "Opt-in native acceptance only. Four movable bodies in a six-metre bright room connected to a dim room; no shipped map bake or Rust test depends on this fixture.",
  "spawn": { "x": 0.0, "z": 0.65, "yaw_degrees": 0.0 },
  "defaults": {
    "wall": "home:wall_paint_offwhite_01",
    "floor": "home:hardwood_oak_01",
    "ceiling": "core:ceiling_panel_01"
  },
  "rooms": [
    { "x": -3.0, "z": -3.0, "width": 6.0, "depth": 6.0, "height": 3.2 },
    { "x": 3.0, "z": -3.0, "width": 6.0, "depth": 6.0, "height": 3.2 },
    { "x": -2.4, "z": -4.2, "width": 1.2, "depth": 1.2, "height": 3.2 }
  ],
  "walls": [
    {
      "x": -3.2, "z": -3.2, "width": 6.4, "depth": 0.2, "height": 3.2,
      "openings": [{ "kind": "door", "offset": 1.0, "width": 0.8, "height": 2.1 }]
    },
    { "x": -3.2, "z": 3.0, "width": 6.4, "depth": 0.2, "height": 3.2 },
    { "x": -3.2, "z": -3.0, "width": 0.2, "depth": 6.0, "height": 3.2 },
    {
      "x": 3.0, "z": -3.0, "width": 0.2, "depth": 6.0, "height": 3.2,
      "openings": [{ "kind": "passage", "offset": 2.4, "width": 1.2, "height": 2.4 }]
    },
    { "x": 3.2, "z": -3.2, "width": 6.0, "depth": 0.2, "height": 3.2 },
    { "x": 3.2, "z": 3.0, "width": 6.0, "depth": 0.2, "height": 3.2 },
    { "x": 9.0, "z": -3.0, "width": 0.2, "depth": 6.0, "height": 3.2 },
    { "x": -2.6, "z": -4.4, "width": 1.6, "depth": 0.2, "height": 3.2 },
    { "x": -2.6, "z": -4.2, "width": 0.2, "depth": 1.2, "height": 3.2 },
    { "x": -1.2, "z": -4.2, "width": 0.2, "depth": 1.2, "height": 3.2 }
  ],
  "stairs": [
    {
      "x": -2.7, "z": 1.7, "width": 1.4, "depth": 0.7,
      "rise": 0.6, "steps": 4,
      "material": "home:hardwood_oak_01",
      "riser_material": "home:wall_paint_offwhite_01",
      "side_material": "home:wall_paint_offwhite_01"
    }
  ],
  "ramps": [
    {
      "x": 1.3, "z": 1.7, "width": 1.4, "depth": 0.7, "rise": 0.6,
      "material": "home:hardwood_oak_01",
      "edge_material": "home:wall_paint_offwhite_01"
    }
  ],
  "ceiling_lights": [
    {
      "id": "fixture_light", "fixture": "core:fluorescent_panel_01",
      "x": 0.0, "z": 0.0, "y": 3.2, "align": "none",
      "brightness": 1.2, "range": 6.0, "color": [1.0, 0.96, 0.9],
      "switchable": true, "switch_group": "fixture_main", "static_switch": "prepared"
    },
    {
      "id": "dim_light", "fixture": "core:fluorescent_panel_01",
      "x": 6.0, "z": 0.0, "y": 3.2, "align": "none",
      "brightness": 0.04, "range": 3.0, "color": [0.8, 0.85, 1.0]
    }
  ],
  "doors": [
    {
      "id": "fixture_door", "x": -2.2, "z": -3.0,
      "width": 0.8, "height": 2.1, "thickness": 0.045,
      "initial_state": "closed", "open_direction": "right", "swing_degrees": 90.0,
      "kind": "interior", "material": "home:door_white_01",
      "frame_material": "home:baseboard_white_01", "handle_material": "core:metal_brass_01",
      "components": [{ "component": "interactable", "prompt": "Open fixture door", "reach": 1.8 }],
      "bindings": [{ "on": "interact", "actions": [{ "action": "toggle" }] }]
    }
  ],
  "props": [
    {
      "id": "fixture_activate", "model": "home:wall_switch", "x": -2.95, "y": 1.2, "z": 0.8,
      "rotation_degrees": 90.0, "size": [0.18, 0.18, 0.1], "solid": false,
      "components": [{ "component": "interactable", "prompt": "Activate fixture items", "reach": 1.8 }],
      "bindings": [{ "on": "interact", "actions": [{ "action": "activate_physics_group", "group": "native_fixture" }] }]
    },
    {
      "id": "fixture_reset", "model": "home:wall_switch", "x": -2.95, "y": 1.2, "z": 0.0,
      "rotation_degrees": 90.0, "size": [0.18, 0.18, 0.1], "solid": false,
      "components": [{ "component": "interactable", "prompt": "Reset fixture items", "reach": 1.8 }],
      "bindings": [{ "on": "interact", "actions": [{ "action": "reset_physics_group", "group": "native_fixture" }] }]
    },
    {
      "id": "fixture_switch", "model": "home:wall_switch", "x": -2.95, "y": 1.2, "z": -1.8,
      "rotation_degrees": 90.0, "size": [0.18, 0.18, 0.1], "solid": false,
      "components": [
        { "component": "interactable", "prompt": "Switch fixture light", "reach": 1.8 },
        { "component": "animation", "clip": "toggle", "looped": false, "playing": false }
      ],
      "bindings": [{ "on": "interact", "actions": [
        { "action": "toggle_animation", "clip": "toggle" },
        { "action": "toggle", "target": "fixture_light" }
      ] }]
    },
    {
      "id": "fixture_table", "model": "home:dining_table",
      "x": 0.0, "z": -0.65, "size": [1.4, 0.75, 0.8], "solid": true
    },
    {
      "id": "pickup_cup", "display_name": "Pickup Cup", "model": "arcade:party_cup_confetti",
      "x": 0.0, "y": 0.75, "z": -0.65, "size": [0.085, 0.122, 0.085],
      "solid": false, "occludes": false,
      "physics": {
        "motion": "dynamic", "reset_group": "native_fixture", "shape": { "kind": "cylinder", "half_height": 0.061, "radius": 0.0425 },
        "mass_kg": 0.025, "friction": 0.55, "restitution": 0.18,
        "linear_damping": 0.02, "angular_damping": 0.12, "pickup": true
      }
    },
    {
      "id": "fixed_cup", "display_name": "Fixed Cup", "model": "arcade:party_cup_confetti",
      "x": 0.35, "y": 0.75, "z": -0.65, "size": [0.085, 0.122, 0.085],
      "solid": false,
      "physics": {
        "motion": "fixed", "shape": { "kind": "cylinder", "half_height": 0.061, "radius": 0.0425 },
        "mass_kg": 0.025, "friction": 0.55, "restitution": 0.18, "pickup": false
      }
    },
    {
      "id": "stairs_ball", "model": "arcade:bowling_ball_purple",
      "x": -2.05, "y": 0.7, "z": 2.05, "size": [0.216, 0.216, 0.216],
      "solid": false, "occludes": false,
      "physics": {
        "motion": "dynamic", "reset_group": "native_fixture", "shape": { "kind": "sphere", "radius": 0.108 },
        "mass_kg": 4.0, "friction": 0.6, "restitution": 0.15,
        "linear_damping": 0.05, "angular_damping": 0.1, "pickup": true
      }
    },
    {
      "id": "ramp_bottle", "model": "arcade:soda_bottle",
      "x": 1.8, "y": 0.7, "z": 2.05, "size": [0.095, 0.28, 0.095],
      "solid": false, "occludes": false,
      "physics": {
        "motion": "dynamic", "reset_group": "native_fixture", "shape": { "kind": "cylinder", "half_height": 0.14, "radius": 0.0475 },
        "mass_kg": 0.25, "friction": 0.45, "restitution": 0.12,
        "linear_damping": 0.05, "angular_damping": 0.1, "pickup": true
      }
    },
    {
      "id": "floor_box", "model": "core:crate",
      "x": 2.0, "y": 0.7, "z": 0.5, "scale": 0.4, "size": [0.6, 0.6, 0.6],
      "solid": false, "occludes": false,
      "physics": {
        "motion": "dynamic", "reset_group": "native_fixture", "shape": { "kind": "cuboid", "half_extents": [0.3, 0.3, 0.3] },
        "mass_kg": 0.3, "friction": 0.65, "restitution": 0.08,
        "linear_damping": 0.05, "angular_damping": 0.15, "pickup": true
      }
    }
  ]
}
